NODE_MANAGER_BOOTSTRAP_ENABLED=false
NODE_MANAGER_BASE_URL=
NODE_MANAGER_TOKEN=
NODE_MANAGER_NAME=Default Node
CONTROL_PLANE_DB_URL=jdbc:mysql://your-rds-host:3306/control-plane?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true
CONTROL_PLANE_DB_USERNAME=control_plane
CONTROL_PLANE_DB_PASSWORD=replace-with-database-password
CONTROL_PLANE_ADMIN_TOKEN=replace-with-admin-token
CONTROL_PLANE_REGISTRATION_TOKEN=replace-with-installer-registration-token
CONTROL_PLANE_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# 仅在 control_users 表为空时初始化第一个管理账号；后续账号和密码在“账号管理”中维护。
CONTROL_PLANE_LOGIN_USERNAME=admin
CONTROL_PLANE_LOGIN_PASSWORD=replace-with-a-strong-password
# 重置密码、停用或删除账号时，该账号的已有 Cookie 会失效。
CONTROL_PLANE_SESSION_TTL_SECONDS=43200
CONTROL_PLANE_PORT=8090
NODE_DEFAULT_MAX_USERS=500

