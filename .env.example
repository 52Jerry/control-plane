# NiuSu Control Plane 生产环境只需要配置以下内容。
# 复制到服务器 /etc/node-control-plane.env 后替换示例值。

SPRING_PROFILES_ACTIVE=prod

CONTROL_PLANE_DB_HOST=your-rds-host
CONTROL_PLANE_DB_USERNAME=control_plane
CONTROL_PLANE_DB_PASSWORD=replace-with-database-password

CONTROL_PLANE_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# 仅在 control_users 表为空时初始化；后续账号在页面“账号管理”中维护。
CONTROL_PLANE_LOGIN_USERNAME=admin
CONTROL_PLANE_LOGIN_PASSWORD=replace-with-a-strong-password

# Node Manager 安装时输入同一个令牌。请使用长随机值。
CONTROL_PLANE_REGISTRATION_TOKEN=replace-with-a-long-random-registration-token

# 可选：反向代理无法正确传递公网 Host/协议时填写，例如 https://control.example.com
CONTROL_PLANE_PUBLIC_URL=

