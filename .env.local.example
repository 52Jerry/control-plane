# NiuSu Control Plane 本地连接阿里云 RDS 的秘密配置模板
# 复制为 .env.local 后填写；.env.local 已被 Git 忽略。

CONTROL_PLANE_DB_URL=jdbc:mysql://your-aliyun-rds-host:3306/control-plane?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
CONTROL_PLANE_DB_USERNAME=your-database-user
CONTROL_PLANE_DB_PASSWORD=replace-with-aliyun-rds-password

# 必须使用生产 Control Plane 的原加密密钥，不能自行生成另一个值。
CONTROL_PLANE_ENCRYPTION_KEY=replace-with-production-encryption-key

# 已有数据库账号时不再执行首次账号初始化。
CONTROL_PLANE_LOGIN_USERNAME=
CONTROL_PLANE_LOGIN_PASSWORD=
CONTROL_PLANE_SESSION_TTL_SECONDS=43200

CONTROL_PLANE_REGISTRATION_TOKEN=
CONTROL_PLANE_ADMIN_TOKEN=
NODE_MANAGER_BOOTSTRAP_ENABLED=false
NODE_DEFAULT_MAX_USERS=500
CONTROL_PLANE_PORT=8090
